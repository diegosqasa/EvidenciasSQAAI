<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapplo.HttpExtensions.JsonNet" Version="2.0.12" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Dapplo.Windows.Clipboard" Version="2.0.89" />
    <PackageReference Include="Dapplo.Windows.Dpi" Version="2.0.89" />
    <PackageReference Include="Dapplo.Windows.Gdi32" Version="2.0.89" />
    <PackageReference Include="Dapplo.Windows.Icons" Version="2.0.89" />
    <PackageReference Include="Dapplo.Windows.Kernel32" Version="2.0.89" />
    <PackageReference Include="Dapplo.Windows.Multimedia" Version="2.0.89" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="log4net" version="3.3.1" />
    <PackageReference Include="Svg" Version="3.4.7" />
    <PackageReference Include="Dapplo.Ini" Version="1.0.149" />
    <PackageReference Include="Dapplo.Ini.Generator" Version="1.0.149" />
    <!-- .NET 9: System.Resources.Extensions y los tipos GAC (Accessibility/CustomMarshalers)
         ya no se referencian; la plataforma Microsoft.WindowsDesktop.App los cubre. -->
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="log4net-embedded.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migración pendiente (.NET 9): System.Runtime.Remoting (RealProxy) y
         CustomMarshalers (TypeToTypeInfoMarshaler) NO existen en .NET Core.
         COMWrapper/IDispatch servían a la automatización COM dinámica; el único
         consumidor real (WindowDetails/IAppVisibility) ya usa creación COM
         directa vía CLSID (Type.GetTypeFromCLSID + Activator). -->
    <Compile Remove="Interop\COMWrapper.cs" />
    <Compile Remove="Interop\IDispatch.cs" />
  </ItemGroup>
</Project>