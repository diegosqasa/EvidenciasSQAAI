<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Fuente explícita: el TFM net9.0-windows10.0.19041.0 del visor necesita
    Microsoft.Windows.SDK.NET.Ref (proyección WinRT para Windows.Media.Ocr).
    La config global de la máquina no expone fuentes → sin esta entrada el
    restore falla con NU1100 aunque haya internet.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
