<UserControl x:Class="EvidenciasSQA.Wpf.Controls.ModalCloseButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="True"
             AutomationProperties.Name="Cerrar">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/EvidenciasSQA.Wpf;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Button x:Name="CloseButton"
            Content="&#x00D7;"
            Style="{StaticResource ModalCloseButtonStyle}"
            Click="CloseButton_Click"
            Focusable="True"
            IsTabStop="True"
            TabIndex="0"
            ToolTip="Cerrar"
            AutomationProperties.Name="Cerrar"
            AutomationProperties.HelpText="Presione Enter o Espacio para cerrar el modal"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Button.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding CloseCommand, ElementName=Root}" />
            <KeyBinding Key="Space" Command="{Binding CloseCommand, ElementName=Root}" />
        </Button.InputBindings>
    </Button>
</UserControl>